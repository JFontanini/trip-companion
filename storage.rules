rules_version = '2';
// Journal photos: trips/{tripId}/photos/{uid}/{file}. Only trip members read; only the author writes
// into their own folder; images only, under 15 MB (the client resizes to about 1 MB first).
service firebase.storage {
  match /b/{bucket}/o {
    match /trips/{tripId}/photos/{uid}/{fileName} {
      function member() {
        return request.auth != null && request.auth.token.email_verified == true
          && request.auth.token.email.lower() in firestore.get(/databases/(default)/documents/trips/$(tripId)).data.memberEmails;
      }
      allow read: if member();
      allow create: if member() && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
