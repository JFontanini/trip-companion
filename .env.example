# Firebase web config for the trip-companion project. Public identifiers, not secrets.
# Local: copy to .env.local. CI: set as GitHub repository variables with the same names.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=techsavvy-dad
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
